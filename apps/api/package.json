{
  "name": "@workeasy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --enable-source-maps --import ./dev-env.mjs dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@workeasy/audience-core": "workspace:*",
    "@workeasy/audience-infra": "workspace:*",
    "@workeasy/channels": "workspace:*",
    "@workeasy/content": "workspace:*",
    "@workeasy/db": "workspace:*",
    "@workeasy/shared": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "csv-parse": "7.0.3",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.14",
    "nodemailer": "10.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@workeasy/config": "workspace:*",
    "tsc-watch": "^7.2.1",
    "tsx": "4.23.15"
  }
}
