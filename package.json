{
  "name": "workeasy-campaign",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @workeasy/db generate",
    "db:migrate": "pnpm --filter @workeasy/db migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
