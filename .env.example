# ── Database (written by `pnpm db:bootstrap`; do not commit real values) ──────────────────────────────
# Superuser/admin connection — used ONLY by the bootstrap script.
DATABASE_ADMIN_URL=
# Schema owner — used ONLY by migrations. Never give this to the API or worker.
DATABASE_OWNER_URL=
# Runtime roles.
DATABASE_URL=
IDENTITY_DATABASE_URL=
REPORTING_DATABASE_URL=

# ── API ───────────────────────────────────────────────────────────────────────────────────────────────
# development | test | production. Missing = production (strict).
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
# ≥ 32 chars. Required in production. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# false | <hop count> | comma list of IPs/CIDRs/keywords (loopback, linklocal, uniquelocal). Never "true".
# Development default: loopback (the local Next.js server).
TRUST_PROXY=
# Required in production (rate limits shared across instances).
REDIS_URL=
# file (development: writes .dev-mail/*.json) | smtp (required in production)
MAIL_TRANSPORT=file
MAIL_FROM=Workeasy Campaign <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Web ───────────────────────────────────────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:4000

# ── Docker Compose (only if you use it) ──────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
MINIO_ROOT_PASSWORD=
