# Postgres: app role is subject to RLS; migration role owns tables
DATABASE_URL=postgresql://workeasy_app:workeasy_app@localhost:5432/workeasy
DATABASE_MIGRATION_URL=postgresql://workeasy:workeasy@localhost:5432/workeasy
REDIS_URL=redis://localhost:6379
# 32-byte base64 keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
ENCRYPTION_KEY=
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SMTP_HOST=localhost
SMTP_PORT=1025
