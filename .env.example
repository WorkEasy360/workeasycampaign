# ── Database (written by `pnpm db:bootstrap`; do not commit real values) ──────────────────────────────
# Superuser/admin connection — used ONLY by the bootstrap script.
DATABASE_ADMIN_URL=
# Schema owner — used ONLY by migrations. Never give this to the API or worker.
DATABASE_OWNER_URL=
# Runtime roles.
DATABASE_URL=
IDENTITY_DATABASE_URL=
REPORTING_DATABASE_URL=

# ── API ───────────────────────────────────────────────────────────────────────────────────────────────
# development | test | production. Missing = production (strict).
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
# ≥ 32 chars. Required in production. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# false | comma list of the proxies' IPs/CIDRs/keywords (loopback, linklocal, uniquelocal). Never "true" or a hop count.
# Development default: loopback (the local Next.js server).
TRUST_PROXY=
# Required in production (rate limits shared across instances).
REDIS_URL=
# file (development: writes .dev-mail/*.json) | smtp (required in production)
MAIL_TRANSPORT=file
MAIL_FROM=Workeasy Campaign <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Background work and campaigns (Phase 7) ───────────────────────────────────────────────────────────
# postgres (required in production) | inline (development/tests)
JOB_QUEUE=
# Comma list: http, jobs, scheduler (default all). Campaign worker deployment: jobs,scheduler. API: http.
PROCESS_ROLES=
JOB_CONCURRENCY=
CAMPAIGN_SCHEDULER_INTERVAL_SECONDS=
# Unsubscribe link key (≥ 32 chars; required in production). Rotate by moving the old key to *_PREVIOUS.
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_SECRETS_PREVIOUS=

# ── Email provider and deliverability (Phase 7.7–7.11) ────────────────────────────────────────────────
# disabled (default: no sending) | live (real sending; requires the provider, webhook and DNS settings below).
# test is for NODE_ENV=test only.
CAMPAIGN_DELIVERY_MODE=
# mailgun. The API key is a SECRET (secrets manager). EU accounts: MAILGUN_BASE_URL=https://api.eu.mailgun.net
DELIVERY_PROVIDER=
MAILGUN_API_KEY=
MAILGUN_BASE_URL=
# What the provider needs in a customer's DNS, e.g. include:mailgun.org and the DKIM selector (e.g. mx).
DELIVERY_SPF_INCLUDE=
DELIVERY_DKIM_SELECTOR=
# Provider webhook signing key (from the provider console). Unset = webhooks off.
DELIVERY_WEBHOOK_SIGNING_KEY=
# opens, clicks, or both (default: none)
DELIVERY_TRACKING=
# Sending rates per second: provider account limit; per-workspace fair share (unset = no limit)
DELIVERY_RATE_PER_SECOND=
WORKSPACE_SEND_RATE_PER_SECOND=

# ── SMS (Twilio) and WhatsApp (Meta Cloud API) — messaging amendment ────────────────────────────────────
# All-or-nothing per provider: a partial configuration fails boot. Tokens and secrets are SECRETS (secrets manager).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exactly one of: a Twilio number (E.164) or a Messaging Service SID (MG…)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The exact public https URL of the API route /v1/webhooks/twilio (Twilio signs it)
TWILIO_STATUS_CALLBACK_URL=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string (≥ 16); enter the same value in the Meta app webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# ── Operations (Phase 7.12) ───────────────────────────────────────────────────────────────────────────
# Bearer token for GET /metrics (≥ 24 chars). Unset = no metrics endpoint.
METRICS_TOKEN=
# policy=limit,… (e.g. auth.login=100 for an office behind one NAT)
RATE_LIMIT_OVERRIDES=

# ── Web ───────────────────────────────────────────────────────────────────────────────────────────────
API_URL=http://127.0.0.1:4000

# ── Docker Compose (only if you use it) ──────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
MINIO_ROOT_PASSWORD=
