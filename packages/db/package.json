{
  "name": "@workeasy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "migrate": "prisma migrate deploy",
    "migrate:test": "tsx scripts/migrate-test.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "^8.23.1",
    "@workeasy/config": "workspace:*",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  }
}
