// Workeasy Campaign data model. Tenant tables carry org_id and are protected by RLS (see migrations).
// The full identity/RBAC model is added in build step 4.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("organizations")
}
