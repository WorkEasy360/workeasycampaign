/// Immutable consent evidence (docs/consent.md). Never updated; deleted only by the retention purge.
model ConsentEvent {
  id                 String   @id @default(uuid(7)) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  contactId          String   @map("contact_id") @db.Uuid
  /// Channel scope (email | sms | whatsapp). NULL for topic-preference events (a topic applies to every channel).
  channel            String?
  topicId            String?  @map("topic_id") @db.Uuid
  /// subscribed | unsubscribed | pending | confirmed | revoked
  action             String
  previousState      String   @map("previous_state")
  newState           String   @map("new_state")
  lawfulBasis        String?  @map("lawful_basis")
  source             String
  actorType          String   @map("actor_type") // contact | user | system | api_key
  actorId            String?  @map("actor_id")
  /// Keyed hash of the channel address at the time; survives erasure without storing personal data.
  subjectFingerprint String?  @map("subject_fingerprint")
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  consentTextVersion String?  @map("consent_text_version")
  formId             String?  @map("form_id")
  formVersion        String?  @map("form_version")
  /// Reference metadata: import id + row, API request id, note, confirmation id.
  evidence           Json     @default("{}")
  correlationId      String   @map("correlation_id") @db.Uuid
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(3)
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [orgId, workspaceId, contactId], references: [orgId, workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, contactId, occurredAt(sort: Desc)])
  @@index([workspaceId, recordedAt])
  @@map("consent_events")
  @@schema("public")
}

/// Projection of channel-scoped consent events: current consent per (contact, channel).
model ConsentState {
  orgId              String   @map("org_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  contactId          String   @map("contact_id") @db.Uuid
  channel            String
  state              String // pending | granted | withdrawn
  changedBy          String   @map("changed_by") // contact | user | system
  lawfulBasis        String?  @map("lawful_basis")
  lastEventId        String   @map("last_event_id") @db.Uuid
  /// When the change happened according to the evidence (may be in the past for paper/verbal consent).
  changedAt          DateTime @map("changed_at") @db.Timestamptz(3)
  /// Server time the current state was recorded. Retention and pending expiry are measured from this, never from
  /// the client-supplied changedAt, so backdating cannot make evidence purgeable or a request expire early.
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Keyed hash of the address the current state applies to (docs/consent.md §Address binding). Consent given for
  /// one address never covers another: eligibility compares it with the current primary address.
  subjectFingerprint String?  @map("subject_fingerprint")

  contact Contact @relation(fields: [orgId, workspaceId, contactId], references: [orgId, workspaceId, id], onDelete: Restrict)

  @@id([contactId, channel])
  @@index([workspaceId, channel, state])
  @@map("consent_states")
  @@schema("public")
}

/// Per-workspace consent-evidence retention (D3). No row = documented defaults (docs/consent.md).
model ConsentRetentionPolicy {
  orgId                     String   @map("org_id") @db.Uuid
  workspaceId               String   @id @map("workspace_id") @db.Uuid
  /// Days to keep evidence after consent is withdrawn; NULL = keep indefinitely (an explicit choice).
  retainAfterWithdrawalDays Int?     @map("retain_after_withdrawal_days")
  /// Days to keep pseudonymized evidence after a contact is erased; NULL = indefinitely.
  retainAfterErasureDays    Int?     @map("retain_after_erasure_days")
  /// Days after which unconfirmed (pending) consent expires.
  pendingExpiryDays         Int      @default(7) @map("pending_expiry_days")
  updatedByUserId           String?  @map("updated_by_user_id") @db.Uuid
  updatedAt                 DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  version                   Int      @default(1)

  workspace Workspace @relation(fields: [orgId, workspaceId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, workspaceId])
  @@map("consent_retention_policies")
  @@schema("public")
}

/// Do-not-contact registry. Rows are never deleted; lifting is recorded on the row.
model Suppression {
  id              String    @id @default(uuid(7)) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  channel         String // email | sms | whatsapp | all
  /// Target is either a contact ...
  contactId       String?   @map("contact_id") @db.Uuid
  /// ... or an address (survives contact deletion and re-creation).
  identityKind    String?   @map("identity_kind")
  valueNormalized String?   @map("value_normalized")
  reason          String // manual | hard_bounce | complaint | compliance | unsubscribe_request | invalid_address
  source          String // admin | import | system | api
  note            String    @default("")
  /// Unique while active, NULL once lifted: at most one active suppression per target and channel.
  activeKey       String?   @map("active_key")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt        DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedByUserId  String?   @map("lifted_by_user_id") @db.Uuid
  liftReason      String?   @map("lift_reason")

  workspace Workspace @relation(fields: [orgId, workspaceId], references: [orgId, id], onDelete: Restrict)
  contact   Contact?  @relation(fields: [orgId, workspaceId, contactId], references: [orgId, workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, activeKey])
  @@index([workspaceId, contactId])
  @@index([workspaceId, identityKind, valueNormalized])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("suppressions")
  @@schema("public")
}

model ContactImport {
